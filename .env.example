# ==============================================================================
# ClearBG AI Studio - Environment Configuration Template
# Copyright (c) 2026 Mohit Sharma. All Rights Reserved.
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the .env file to public or private version control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS allowance)
CLIENT_URL=http://localhost:3000

# MongoDB Atlas Connection String
# Get this from MongoDB Atlas Dashboard > Clusters > Connect > Drivers
# Format: mongodb+srv://<username>:<password>@<cluster-url>/cleanbg?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/cleanbg?retryWrites=true&w=majority

# Gmail SMTP Email Configuration (Used for OTP verification & account alerts)
# Generate a 16-character App Password from Google Account > Security > 2-Step Verification > App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="ClearBG AI" <no-reply@clearbg.ai>

# JWT Authentication Secret
JWT_SECRET=generate_a_strong_random_secret_string_min_32_chars
