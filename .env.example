# ==============================================================================
# ClearBG AI Studio - Environment Configuration Template
# Copyright (c) 2026 Mohit Chadha. All Rights Reserved.
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the .env file to public or private version control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (for CORS allowance)
CLIENT_URL=http://localhost:3000

# PostgreSQL Database Configuration
# You can use individual fields or a full DATABASE_URL connection string (e.g. from Supabase/Neon/Vercel Postgres)
PGUSER=postgres
PGHOST=localhost
PGDATABASE=clearbg_db
PGPORT=5432
PGPASSWORD=your_secure_postgres_password
# Optional cloud connection string:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Gmail SMTP Email Configuration (Used for OTP verification & account alerts)
# Generate a 16-character App Password from Google Account > Security > 2-Step Verification > App Passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_character_app_password
SMTP_FROM="ClearBG AI" <no-reply@clearbg.ai>

# JWT Authentication Secret
JWT_SECRET=generate_a_strong_random_secret_string_min_32_chars
